# Copy to .env and fill in your own secrets. Never commit .env.
# Use the exact chat model ID supported by your provider.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini

# Online search is independent of the chat model. Restart after changes.
TAVILY_API_KEY=

# Optional: use an embedding model, never a chat model.
# Leave EMBEDDING_MODEL empty to use local lexical retrieval.
EMBEDDING_MODEL=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=

# Defaults: project-local SQLite and Chroma.
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/research
# DATA_DIR=D:/research-data
COOKIE_SECURE=false
SESSION_DAYS=7
MAX_UPLOAD_MB=20
MAX_PROJECT_CHUNKS=20000
TRUSTED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
